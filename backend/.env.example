# DocuSentinel AI — Backend Environment Variables
# ─────────────────────────────────────────────────────────────────────────────
# Copy this file to .env and fill in your values.
# The system works WITHOUT an LLM key (evidence-only mode).
# Add a key to enable full AI-powered reasoning on top of the evidence.
# ─────────────────────────────────────────────────────────────────────────────

# ── LLM PROVIDER (any OpenAI-compatible API) ────────────────────────────────
# Option A — Groq (FREE, fast, recommended for demos):
#   LLM_API_KEY=gsk_xxxxxxxxxxxxxxxxxxxx
#   LLM_MODEL=llama-3.3-70b-versatile
#   LLM_BASE_URL=https://api.groq.com/openai/v1
#   → Get key: https://console.groq.com
#
# Option B — OpenAI:
#   LLM_API_KEY=sk-xxxxxxxxxxxxxxxxxxxx
#   LLM_MODEL=gpt-4o-mini
#   LLM_BASE_URL=          (leave blank)
#
# Option C — Local Ollama:
#   LLM_API_KEY=ollama
#   LLM_MODEL=llama3.2
#   LLM_BASE_URL=http://localhost:11434/v1
# ─────────────────────────────────────────────────────────────────────────────
LLM_API_KEY=
LLM_MODEL=llama-3.3-70b-versatile
LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_TEMPERATURE=0.1
LLM_MAX_TOKENS=1500

# ── APPLICATION ──────────────────────────────────────────────────────────────
APP_NAME=DocuSentinel AI
APP_VERSION=1.0.0
DEBUG=false
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# ── STORAGE ──────────────────────────────────────────────────────────────────
# Use absolute paths to avoid working-directory confusion
UPLOAD_DIR=../data/uploads
VECTORSTORE_DIR=../data/vectorstore
DATABASE_URL=sqlite+aiosqlite:///./data/docusentinel.db

# ── PROCESSING ───────────────────────────────────────────────────────────────
MAX_FILE_SIZE_MB=50
CHUNK_SIZE=150          # words per chunk — keep small for better retrieval
CHUNK_OVERLAP=20
TOP_K_RETRIEVAL=8
SIMILARITY_THRESHOLD=0.05

# ── OPTIONAL: Tesseract OCR for scanned images ───────────────────────────────
# TESSERACT_CMD=C:\Program Files\Tesseract-OCR\tesseract.exe
